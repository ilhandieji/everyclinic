generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  username                String?                  @unique
  email                   String                   @unique
  emailVerified           DateTime?                @map("email_verified")
  image                   String?
  passwordHash            String                   @map("password_hash")
  accounts                Account[]
  sessions                Session[]
  patientProfile          PatientProfile?
  physicianProfile        PhysicianProfile?
  notifications           Notification[]
  authoredPrescriptions   Prescription[]           @relation("PrescriptionAuthor")
  medicationStatusEvents  MedicationStatusEvent[]
  createdReminders        FollowUpReminder[]

  @@map("users")
}

/// Public registration creates this row. It holds no clinical fields.
model PatientProfile {
  id                String             @id @default(cuid())
  userId            String             @unique @map("user_id")
  createdAt         DateTime           @default(now()) @map("created_at")
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests          ServiceRequest[]
  careRelationships CareRelationship[]
  prescriptions     Prescription[]
  reminders         FollowUpReminder[]

  @@map("patient_profiles")
}

/// Inserted only by a direct database statement. Application code must not create this row.
/// `singleton` is always 1 so the public site has one physician.
/// SQL check `physician_profiles_singleton_is_one` enforces that value.
model PhysicianProfile {
  id                String             @id @default(cuid())
  userId            String             @unique @map("user_id")
  singleton         Int                @unique @default(1)
  displayName       String?            @map("display_name")
  gender            String?
  bio               String?            @db.Text
  photoKey          String?            @map("photo_key")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  services          MedicalService[]
  careRelationships CareRelationship[]
  prescriptions     Prescription[]
  reminders         FollowUpReminder[]
  bookingDays       BookingDay[]

  @@map("physician_profiles")
}

/// Price pairs are enforced by SQL check `medical_services_price_bounds`
/// (both null, or both set, with 0 <= min <= max <= 1000000000000).
model MedicalService {
  id                 String           @id @default(cuid())
  physicianProfileId String           @map("physician_profile_id")
  title              String
  description        String           @db.Text
  priceMin           BigInt?          @map("price_min")
  priceMax           BigInt?          @map("price_max")
  currencyLabel      String?          @map("currency_label")
  imageKey           String?          @map("image_key")
  published          Boolean          @default(false)
  sortOrder          Int              @default(0) @map("sort_order")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  physician          PhysicianProfile @relation(fields: [physicianProfileId], references: [id], onDelete: Cascade)
  sections           ServiceSection[]
  requests           ServiceRequest[]

  @@index([physicianProfileId, sortOrder])
  @@map("medical_services")
}

model ServiceSection {
  id        String         @id @default(cuid())
  serviceId String         @map("service_id")
  title     String
  body      String         @db.Text
  sortOrder Int            @default(0) @map("sort_order")
  service   MedicalService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, sortOrder])
  @@map("service_sections")
}

enum ServiceRequestStatus {
  pending
  accepted
  declined
  cancelled

  @@map("service_request_status")
}

/// One pending request per patient and service is enforced by SQL index
/// `service_requests_one_pending`. Do not drop it from a schema diff.
model ServiceRequest {
  id               String               @id @default(cuid())
  patientProfileId String               @map("patient_profile_id")
  serviceId        String               @map("service_id")
  note             String?              @db.Text
  status           ServiceRequestStatus @default(pending)
  bookingWindowId  String?              @unique @map("booking_window_id")
  exactVisitAt     DateTime?            @map("exact_visit_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  patient          PatientProfile       @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  service          MedicalService       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  bookingWindow    BookingWindow?       @relation(fields: [bookingWindowId], references: [id], onDelete: Restrict)

  @@index([patientProfileId, status])
  @@index([serviceId, status])
  @@map("service_requests")
}

/// One civil day of clinic availability for the singleton physician.
model BookingDay {
  id                 String           @id @default(cuid())
  physicianProfileId String           @map("physician_profile_id")
  date               DateTime         @db.Date
  closed             Boolean          @default(false)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  physician          PhysicianProfile @relation(fields: [physicianProfileId], references: [id], onDelete: Cascade)
  windows            BookingWindow[]

  @@unique([physicianProfileId, date])
  @@index([physicianProfileId, date])
  @@map("booking_days")
}

/// A bookable time range on a booking day (Tehran civil HH:mm).
model BookingWindow {
  id           String          @id @default(cuid())
  bookingDayId String          @map("booking_day_id")
  startTime    String          @map("start_time")
  endTime      String          @map("end_time")
  createdAt    DateTime        @default(now()) @map("created_at")
  day          BookingDay      @relation(fields: [bookingDayId], references: [id], onDelete: Cascade)
  request      ServiceRequest?

  @@unique([bookingDayId, startTime, endTime])
  @@index([bookingDayId])
  @@map("booking_windows")
}

model CareRelationship {
  id                 String           @id @default(cuid())
  physicianProfileId String           @map("physician_profile_id")
  patientProfileId   String           @map("patient_profile_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  physician          PhysicianProfile @relation(fields: [physicianProfileId], references: [id], onDelete: Cascade)
  patient            PatientProfile   @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@unique([physicianProfileId, patientProfileId])
  @@map("care_relationships")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum NotificationCategory {
  service_request
  reminder
  medication

  @@map("notification_category")
}

model Notification {
  id              String               @id @default(cuid())
  recipientUserId String               @map("recipient_user_id")
  category        NotificationCategory
  title           String
  body            String               @db.Text
  href            String
  readAt          DateTime?            @map("read_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  dedupeKey       String               @unique @map("dedupe_key")
  recipient       User                 @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt])
  @@map("notifications")
}

model Prescription {
  id                 String                   @id @default(cuid())
  patientProfileId   String                   @map("patient_profile_id")
  physicianProfileId String                   @map("physician_profile_id")
  authoredByUserId   String                   @map("authored_by_user_id")
  medicationName     String                   @map("medication_name")
  dosage             String
  frequency          String
  notes              String?                  @db.Text
  prescribedAt       DateTime                 @map("prescribed_at")
  startDate          DateTime                 @map("start_date")
  renewsId           String?                  @unique @map("renews_id")
  createdAt          DateTime                 @default(now()) @map("created_at")
  patient            PatientProfile           @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  physician          PhysicianProfile         @relation(fields: [physicianProfileId], references: [id], onDelete: Restrict)
  author             User                     @relation("PrescriptionAuthor", fields: [authoredByUserId], references: [id], onDelete: Restrict)
  renews             Prescription?            @relation("PrescriptionRenewal", fields: [renewsId], references: [id], onDelete: Restrict)
  renewedBy          Prescription?            @relation("PrescriptionRenewal")
  statusEvents       MedicationStatusEvent[]

  @@index([patientProfileId, prescribedAt])
  @@map("prescriptions")
}

enum MedicationStatus {
  active
  completed
  discontinued

  @@map("medication_status")
}

model MedicationStatusEvent {
  id               String           @id @default(cuid())
  prescriptionId   String           @map("prescription_id")
  status           MedicationStatus
  authoredByUserId String           @map("authored_by_user_id")
  occurredAt       DateTime         @default(now()) @map("occurred_at")
  endDate          DateTime?        @map("end_date")
  note             String?          @db.Text
  prescription     Prescription     @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  author           User             @relation(fields: [authoredByUserId], references: [id], onDelete: Restrict)

  @@index([prescriptionId, occurredAt])
  @@map("medication_status_events")
}

enum FollowUpReminderStatus {
  pending
  completed
  cancelled

  @@map("follow_up_reminder_status")
}

model FollowUpReminder {
  id                 String                 @id @default(cuid())
  patientProfileId   String                 @map("patient_profile_id")
  physicianProfileId String                 @map("physician_profile_id")
  createdByUserId    String                 @map("created_by_user_id")
  title              String
  message            String                 @db.Text
  dueAt              DateTime               @map("due_at")
  status             FollowUpReminderStatus @default(pending)
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  patient            PatientProfile         @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  physician          PhysicianProfile       @relation(fields: [physicianProfileId], references: [id], onDelete: Restrict)
  creator            User                   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  deliveries         ReminderDelivery[]

  @@index([patientProfileId, dueAt])
  @@index([status, dueAt])
  @@map("follow_up_reminders")
}

enum ReminderDeliveryKind {
  created
  due

  @@map("reminder_delivery_kind")
}

enum ReminderDeliveryChannel {
  in_app

  @@map("reminder_delivery_channel")
}

model ReminderDelivery {
  id             String                   @id @default(cuid())
  reminderId     String                   @map("reminder_id")
  kind           ReminderDeliveryKind
  channel        ReminderDeliveryChannel  @default(in_app)
  idempotencyKey String                   @unique @map("idempotency_key")
  createdAt      DateTime                 @default(now()) @map("created_at")
  reminder       FollowUpReminder         @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@map("reminder_deliveries")
}
